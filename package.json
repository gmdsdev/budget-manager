{
  "name": "budget-manager",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6",
      "@types/bun": "^1.3.14",
      "@types/node": "^22.13.14",
      "hono": "^4.12.27",
      "@trpc/server": "^11.18.0",
      "better-auth": "1.6.23",
      "@phosphor-icons/react": "^2.1.10",
      "next-themes": "^0.4.6",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sonner": "^2.0.7",
      "@trpc/client": "^11.18.0",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.2",
      "drizzle-orm": "^0.45.2",
      "recharts": "^3.8.0",
      "@types/pg": "^8.20.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e -F @budget-manager/e2e",
    "test:e2e:api": "turbo run test:e2e:api -F @budget-manager/e2e",
    "test:e2e:ui": "turbo run test:e2e:ui -F @budget-manager/e2e",
    "seed:demo": "bun apps/demo-seed/src/index.ts",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "db:push": "turbo run db:push -F @budget-manager/db",
    "db:studio": "turbo run db:studio -F @budget-manager/db",
    "db:generate": "turbo run db:generate -F @budget-manager/db",
    "db:migrate": "turbo run db:migrate -F @budget-manager/db",
    "db:start": "turbo run db:start -F @budget-manager/db",
    "db:watch": "turbo run db:watch -F @budget-manager/db",
    "db:stop": "turbo run db:stop -F @budget-manager/db",
    "db:down": "turbo run db:down -F @budget-manager/db",
    "deploy:setup": "vercel link",
    "dev:vercel": "vercel dev -L",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "deploy:check": "vercel deploy --dry",
    "prepare": "husky"
  },
  "dependencies": {
    "@budget-manager/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@budget-manager/config": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "eslint": "^9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "tsx": "^4.22.5",
    "turbo": "^2.10.2",
    "typescript": "catalog:",
    "typescript-eslint": "^8.65.0",
    "vercel": "^54.18.6"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
      "eslint --fix --max-warnings=0"
    ]
  },
  "packageManager": "bun@1.3.14"
}
