# Where the phone should reach the API. Optional in development: when unset, the app
# resolves the machine running Metro (`src/lib/server-url.ts`), which is what a
# simulator and a device on the same network both need — `localhost` would resolve to
# the phone itself.
#
# Set it for a real build, or for a device that cannot see the bundler's host.
EXPO_PUBLIC_SERVER_URL=http://localhost:3000
