{
  "expo": {
    "name": "Kivo",
    "slug": "kivo",
    "scheme": "kivo",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#191919",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.gmds.kivo",
      "entitlements": {
        "com.apple.security.application-groups": ["group.dev.gmds.kivo"]
      }
    },
    "android": {
      "package": "dev.gmds.kivo",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111111"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      "@bacons/apple-targets"
    ]
  }
}
