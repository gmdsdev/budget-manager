{
  "extends": "@budget-manager/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Callbacks passed to page.$$eval / page.waitForFunction are serialized and
    // run inside the browser, so they legitimately reference DOM globals.
    "lib": ["ESNext", "DOM"],
    // Nothing here renders. It is set because reading a constant out of
    // `@budget-manager/client` puts a `.tsx` in the *type* graph — the repeats
    // label helper's `EnumLabels` reaches `@budget-manager/i18n/react` — and tsc
    // type-checks that file whether or not any JSX is ever emitted.
    "jsx": "react-jsx"
  },
  "include": ["src"]
}
